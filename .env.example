# Copy this file to .env and adjust the values below.

# Postgres — matches the credentials in docker-compose.yml by default.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_status_report?schema=public"

# Azure DevOps API (used to sync new projects added via /projects — a single
# organization/PAT is shared by every project registered in the app).
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=your-azure-devops-pat-here

# Meeting attachments (lib/s3.ts). These defaults point at the local "floci"
# container from docker-compose.yml (a free LocalStack-compatible S3
# emulator, see https://floci.io/aws/) — run `npm run db:up`, then create the
# bucket once with:
#   aws s3 mb s3://project-status-report --endpoint-url http://localhost:4566
# (or via the Floci UI dashboard at http://localhost:3020). Swap these for a
# real AWS bucket/credentials + remove AWS_S3_ENDPOINT to use production S3.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_S3_BUCKET="project-status-report"
AWS_S3_ENDPOINT="http://localhost:4566"
AWS_S3_FORCE_PATH_STYLE="true"

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-your-own-secret-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Email (SMTP) — used for invites, "esqueci minha senha" and the
# "reunião publicada" notification sent to clients.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
# "true" only for port 465 (implicit TLS). Leave "false" for 587/25 (STARTTLS).
SMTP_SECURE="true"
SMTP_USER="user@example.com"
SMTP_PASSWORD="your-smtp-password-here"
EMAIL_FROM="Project Status Report <user@example.com>"
